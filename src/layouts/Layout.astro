---
import { ViewTransitions } from 'astro:transitions';
import { fade } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const { pageTitle } = Astro.props;
---
<!DOCTYPE html>
<html transition:animate="none" lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="description" content="Jaime Astudillo · Forward-Deployed AI Engineer. LLM systems on OpenAI and AWS Bedrock, computer vision for medical imaging, .NET 8 and React in production. Four peer-reviewed papers in reinforcement learning, Bayesian inference, deep learning, and YOLO. Remote, EST." />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <ViewTransitions />
    </head>
    <body>
        <div class="sheet">
            <Header />
            <main transition:animate={fade({ duration: '0.18s' })}>
                <slot />
            </main>
            <Footer />
        </div>
        <script>
            function colorMode() {
                const stored = localStorage.getItem('theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                const isDark = stored === 'dark' || (!stored && prefersDark);
                document.documentElement.classList.toggle('dark', isDark);
            }
            colorMode();
            document.addEventListener('astro:after-swap', colorMode);
        </script>
    </body>
</html>
