---
import BaseLayout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
    <article class="paper prose">
        <a class="prose__back" href="/#research">← Back to research</a>

        <h1>{frontmatter.title}</h1>

        <ul class="badge__list">
            <li>
                <span class="badge badge--item">AUTHORS</span>{frontmatter.author}
            </li>
            {frontmatter.authorPosition && (
                <li>
                    <span class="badge badge--item">POSITION</span>{frontmatter.authorPosition}
                </li>
            )}
            {frontmatter.venue && (
                <li>
                    <span class="badge badge--item">VENUE</span>{frontmatter.venue}
                </li>
            )}
            <li>
                <span class="badge badge--item">PUBLISHED</span>{frontmatter.date}
            </li>
            {frontmatter.external_url && (
                <li>
                    <span class="badge badge--item">LINK</span>
                    <a class="badge__link" href={frontmatter.external_url} target="_blank" rel="noopener noreferrer">
                        {frontmatter.external_url}
                    </a>
                </li>
            )}
        </ul>

        {frontmatter.image && (
            <figure class="figure">
                <img
                    src={frontmatter.image.url}
                    alt={frontmatter.image.alt}
                    loading="eager"
                />
                <figcaption>{frontmatter.image.alt}</figcaption>
            </figure>
        )}

        <slot />
    </article>
</BaseLayout>
