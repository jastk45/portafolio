---
import { getCollection } from "astro:content";
import { Image } from 'astro:assets';
import Layout from "../layouts/Layout.astro";
import jaimePhoto from "../assets/jaime.png";

const skills = [
    "C# / .NET 8",
    "Python",
    "TypeScript",
    "React + Next.js",
    "OpenAI + LangGraph",
    "PyTorch",
];

const pageTitle = "Jaime Astudillo · Forward-Deployed AI Engineer · LLM systems + Computer Vision · Published Researcher";

const orcid    = "https://orcid.org/0009-0009-0602-2458";
const scholar  = "https://scholar.google.com.ec/citations?user=3VGlQTgAAAAJ";
const github   = "https://github.com/Jastk45";
const linkedin = "https://www.linkedin.com/in/jastk45/";
const mail     = "mailto:jastk45@gmail.com";
const phone    = "tel:+593969081119";

const allPosts = (await getCollection("posts")).sort(
    (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);

const experience = [
    {
        slug: "project-1",
        tabLabel: "logiztik",
        period: "2026–now",
        role: "Full-Stack Developer",
        company: "Logiztik Alliance Group",
        note: ".NET 8 · React 18 · SQL Server · Kafka. Transactional bidirectional replication across Azure, Miami, and Tumbaco data centers.",
        bullets: [
            "Cross-data-center bidirectional replication keeping three SQL Server sites in sync, 1–3s replication latency.",
            "Full-stack feature work on .NET 8 / ASP.NET Core / EF Core backend and React 18 / Next.js 14 / TypeScript frontend.",
            "Stored-procedure tuning and LINQ optimization for thousands of logistics transactions per day.",
            "Structured logging via Serilog into Elasticsearch; CI/CD through Azure DevOps and Docker."
        ]
    },
    {
        slug: "project-2",
        tabLabel: "mesinalabs",
        period: "2025–2026",
        role: "Full-Stack AI Engineer (Freelance)",
        company: "MesinaLabs · JEANS.CH",
        note: "Embeddable shopping assistant for a Swiss jeans retailer. Next.js 16 widget with Shadow-DOM isolation, FastAPI + LangGraph backend.",
        bullets: [
            "Next.js 16 / React 19 widget embeddable via single <script> tag with full Shadow DOM CSS isolation.",
            "FastAPI endpoints and LangGraph agent (graph + tools + prompts) for conversational commerce.",
            "Multi-language detection (EN, DE, FR) with FastText + Lingua; sentence-transformers for retrieval.",
            "Load-tested with Locust at 100–200 concurrent users with 80% Redis cache hit rate."
        ]
    },
    {
        slug: "project-3",
        tabLabel: "ifg",
        period: "2024–2025",
        role: "Frontend & AI Developer",
        company: "IFG Innovaciones Agropecuarias",
        note: "Next.js + ML for agricultural nutrition recommendations. Power BI integrations for sales insights.",
        bullets: [
            "Next.js web applications with TensorFlow and Scikit-learn models served via FastAPI.",
            "Recommendation system for agricultural crop nutrition, deployed via Docker.",
            "Power BI integrations and Python pipelines for sales metrics and strategic dashboards."
        ]
    },
    {
        slug: "project-4",
        tabLabel: "digevo",
        period: "2025",
        role: "Business Support & Monitoring",
        company: "Digevo · SENDIA",
        note: "Grafana, Airflow, Nagios. SLA monitoring on transactional systems and SaaS billing platform.",
        bullets: [
            "Monitoring transactional systems through Grafana dashboards and Airflow pipelines.",
            "Remote SQL operations and SMPP server interventions for SMS-billing flows.",
            "Incident triage through Nagios + Freshdesk; documented runbooks for first-line support."
        ]
    }
];

const education = [
    {
        period: "2018–2024",
        title: "Engineer in Information Technology",
        inst: "Yachay Tech University, Ecuador"
    },
    {
        period: "2024–2025",
        title: "Diploma in Applied AI in Education",
        inst: "UDLA, Ecuador"
    }
];

const certs = [
    { year: "2026", name: "Design Patterns & SOLID Principles in C# .NET", org: "Udemy" },
    { year: "2024", name: "Transformer-Based NLP Applications",            org: "NVIDIA" },
    { year: "2024", name: "Generative AI with Diffusion Models",           org: "NVIDIA" },
    { year: "2024", name: "Scrum Foundation Professional Certificate",     org: "SFPC" },
    { year: "2024", name: "EDA y Visualización de Datos",                  org: "Self-paced" },
    { year: "2023", name: "JavaScript School",                             org: "Código Facilito" }
];
---

<Layout pageTitle={pageTitle}>
    <section class="hero">
        <p class="hero__eyebrow">Hi, my name is</p>
        <h1 class="hero__name">
            Jaime Vicente
            <span class="hero__surname">Astudillo Tobar</span>
        </h1>
        <p class="hero__role">Forward-Deployed AI Engineer · LLM systems + Computer Vision · Remote · EST</p>
        <p class="hero__lede">
            Published researcher shipping production systems. Currently at
            <strong>Logiztik Alliance Group</strong> on cross-data-center
            transactional replication with .NET 8 and Kafka. Building
            LLM-integrated products on OpenAI and AWS Bedrock.
        </p>
        <ul class="hero__stats" aria-label="At a glance">
            <li><strong>4</strong> peer-reviewed papers</li>
            <li><strong>1×</strong> first author (Springer 2023)</li>
            <li><strong>.NET 8</strong> · Python · React · LLMs</li>
        </ul>
        <div class="hero__contact" id="contact">
            <a href={mail}>mail</a>
            <a href={phone}>phone</a>
            <a href={github}   target="_blank" rel="noopener noreferrer">github</a>
            <a href={orcid}    target="_blank" rel="noopener noreferrer">orcid</a>
            <a href={scholar}  target="_blank" rel="noopener noreferrer">scholar</a>
            <a href={linkedin} target="_blank" rel="noopener noreferrer">linkedin</a>
        </div>
    </section>

    <section class="section" id="about">
        <div class="section__label">
            <h2>About</h2>
        </div>
        <div class="about">
            <div class="about__body">
                <p>
                    I'm an IT Engineer from Ecuador focused on bringing
                    research-grade machine learning into production systems.
                    My background is split between published research (four
                    peer-reviewed papers across reinforcement learning,
                    Bayesian inference, computer vision, and YOLO-based
                    drone detection) and shipping enterprise software.
                </p>
                <p>
                    Today I'm at <strong>Logiztik Alliance Group</strong>
                    on cross-data-center transactional replication with
                    .NET 8 and Kafka, and I build LLM-integrated products
                    on OpenAI and AWS Bedrock as a freelance Full-Stack
                    AI Engineer.
                </p>
                <p>
                    I care about the parts that make a system actually
                    work in production: latency, observability, honest
                    evaluation, reproducibility, and a clear story for
                    why each trade-off was made.
                </p>
                <p>Here are a few technologies I've been working with recently:</p>
                <ul class="about__skills">
                    {skills.map((s) => <li>{s}</li>)}
                </ul>
            </div>
            <div class="about__photo">
                <Image
                    src={jaimePhoto}
                    alt="Jaime Astudillo"
                    format="webp"
                    quality={82}
                    widths={[200, 400]}
                    sizes="(min-width: 800px) 280px, 200px"
                />
            </div>
        </div>
    </section>

    <section class="section" id="work">
        <div class="section__label">
            <h2>Selected work</h2>
        </div>
        <div class="work-tabs" data-work-tabs>
            <div class="work-tabs__list" role="tablist" aria-label="Selected work">
                <span class="work-tabs__indicator" aria-hidden="true"></span>
                {experience.map((e, i) => (
                    <button
                        type="button"
                        role="tab"
                        id={`work-tab-${i}`}
                        aria-selected={i === 0 ? "true" : "false"}
                        aria-controls={`work-panel-${i}`}
                        tabindex={i === 0 ? 0 : -1}
                        class="work-tabs__tab"
                        data-index={i}
                    >{e.tabLabel}</button>
                ))}
            </div>
            {experience.map((e, i) => (
                <div
                    id={`work-panel-${i}`}
                    role="tabpanel"
                    aria-labelledby={`work-tab-${i}`}
                    hidden={i !== 0}
                    class="work-tabs__panel"
                >
                    <h3 class="work-tabs__role">
                        <a href={`/projects/${e.slug}/`}>{e.role}</a>
                        <span class="work-tabs__company"> @ {e.company}</span>
                    </h3>
                    <p class="work-tabs__period">{e.period}</p>
                    <ul class="work-tabs__bullets">
                        {e.bullets.map((b) => <li>{b}</li>)}
                    </ul>
                </div>
            ))}
        </div>
    </section>

    <section class="section" id="research">
        <div class="section__label">
            <h2>Selected research</h2>
            <span>
                {allPosts.length} papers · full list on
                <a href={orcid} target="_blank" rel="noopener noreferrer">ORCID</a>
                · <a href={scholar} target="_blank" rel="noopener noreferrer">Scholar</a>
            </span>
        </div>
        <div class="featured-list">
            {allPosts.map((p, i) => {
                const href = p.data.external_url ?? `/posts/${p.slug}/`;
                const external = !!p.data.external_url;
                const reversed = i % 2 === 1;
                return (
                    <article class:list={["featured", { "featured--reversed": reversed }]}>
                        {p.data.image && (
                            <a
                                class="featured__image"
                                href={href}
                                target={external ? "_blank" : undefined}
                                rel={external ? "noopener noreferrer" : undefined}
                                aria-label={p.data.title}
                            >
                                <Image
                                    src={p.data.image.src}
                                    alt={p.data.image.alt}
                                    loading="lazy"
                                    format="webp"
                                    quality={82}
                                    widths={[400, 800, 1200]}
                                    sizes="(min-width: 800px) 55vw, 100vw"
                                />
                            </a>
                        )}
                        <div class="featured__content">
                            <p class="featured__overline">Featured paper · {p.data.authorPosition ?? p.data.venue}</p>
                            <h3 class="featured__title">
                                <a
                                    href={href}
                                    target={external ? "_blank" : undefined}
                                    rel={external ? "noopener noreferrer" : undefined}
                                >{p.data.title}</a>
                            </h3>
                            {p.data.summary && (
                                <div class="featured__description">
                                    <p>{p.data.summary}</p>
                                </div>
                            )}
                            {p.data.venue && (
                                <p class="featured__venue">
                                    <span>{p.data.venue}</span>
                                </p>
                            )}
                            <p class="featured__links">
                                <a
                                    href={href}
                                    target={external ? "_blank" : undefined}
                                    rel={external ? "noopener noreferrer" : undefined}
                                    aria-label={`Read ${p.data.title}`}
                                >Read paper →</a>
                            </p>
                        </div>
                    </article>
                );
            })}
        </div>
    </section>

    <section class="section" id="background">
        <div class="section__label">
            <h2>Background</h2>
        </div>
        <div class="bg-grid">
            <div class="bg-col">
                <h3 class="bg-col__title">Education</h3>
                <ul class="bg-list">
                    {education.map((e) => (
                        <li>
                            <span class="bg-list__title">{e.title}</span>
                            <span class="bg-list__sub">{e.inst}</span>
                            <span class="bg-list__meta">{e.period}</span>
                        </li>
                    ))}
                </ul>
            </div>
            <div class="bg-col">
                <h3 class="bg-col__title">Certifications</h3>
                <ul class="bg-list bg-list--compact">
                    {certs.map((c) => (
                        <li>
                            <span class="bg-list__title">{c.name}</span>
                            <span class="bg-list__sub">{c.org} · {c.year}</span>
                        </li>
                    ))}
                </ul>
            </div>
            <div class="bg-col">
                <h3 class="bg-col__title">Languages</h3>
                <ul class="bg-list">
                    <li>
                        <span class="bg-list__title">Spanish</span>
                        <span class="bg-list__sub">Native</span>
                    </li>
                    <li>
                        <span class="bg-list__title">English</span>
                        <span class="bg-list__sub">B2</span>
                    </li>
                </ul>
            </div>
        </div>
    </section>
</Layout>

<script>
    function initWorkTabs() {
        const root = document.querySelector<HTMLElement>('[data-work-tabs]');
        if (!root) return;

        const tabs    = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        const panels  = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
        const indicator = root.querySelector<HTMLElement>('.work-tabs__indicator');
        const list = root.querySelector<HTMLElement>('.work-tabs__list');
        if (!tabs.length || !indicator || !list) return;

        function isDesktop() {
            return window.matchMedia('(min-width: 800px)').matches;
        }

        function moveIndicator(tab: HTMLButtonElement) {
            const tabRect = tab.getBoundingClientRect();
            const listRect = list!.getBoundingClientRect();
            if (isDesktop()) {
                const y = tabRect.top - listRect.top;
                indicator!.style.transform = `translateY(${y}px)`;
                indicator!.style.height = `${tabRect.height}px`;
                indicator!.style.width = '2px';
            } else {
                const x = tabRect.left - listRect.left + list!.scrollLeft;
                indicator!.style.transform = `translateX(${x}px)`;
                indicator!.style.width = `${tabRect.width}px`;
                indicator!.style.height = '2px';
            }
        }

        function activate(index: number, focus = true) {
            tabs.forEach((tab, i) => {
                const active = i === index;
                tab.setAttribute('aria-selected', active ? 'true' : 'false');
                tab.setAttribute('tabindex', active ? '0' : '-1');
            });
            panels.forEach((panel, i) => {
                if (i === index) {
                    panel.removeAttribute('hidden');
                } else {
                    panel.setAttribute('hidden', '');
                }
            });
            moveIndicator(tabs[index]);
            if (focus) tabs[index].focus();
        }

        tabs.forEach((tab, i) => {
            tab.addEventListener('click', () => activate(i));
            tab.addEventListener('keydown', (e: KeyboardEvent) => {
                let next = -1;
                if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = (i + 1) % tabs.length;
                else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
                else if (e.key === 'Home') next = 0;
                else if (e.key === 'End') next = tabs.length - 1;
                if (next >= 0) {
                    e.preventDefault();
                    activate(next);
                }
            });
        });

        // initial position (defer one frame so layout is settled)
        requestAnimationFrame(() => {
            const initial = tabs.findIndex(t => t.getAttribute('aria-selected') === 'true');
            moveIndicator(tabs[initial >= 0 ? initial : 0]);
        });

        // reposition on resize
        let resizeTimer: number | undefined;
        window.addEventListener('resize', () => {
            window.clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(() => {
                const current = tabs.findIndex(t => t.getAttribute('aria-selected') === 'true');
                moveIndicator(tabs[current >= 0 ? current : 0]);
            }, 100);
        });
    }

    initWorkTabs();
    document.addEventListener('astro:after-swap', initWorkTabs);
</script>
