---
const links = [
    { href: 'https://github.com/Jastk45',                            label: 'GitHub',   icon: 'gh' },
    { href: 'https://www.linkedin.com/in/jastk45/',                  label: 'LinkedIn', icon: 'in' },
    { href: 'https://orcid.org/0009-0009-0602-2458',                 label: 'ORCID',    icon: 'or' },
    { href: 'https://scholar.google.com.ec/citations?user=3VGlQTgAAAAJ', label: 'Google Scholar', icon: 'gs' },
];
---
<aside class="side side--left" aria-hidden="false">
    <ul class="side__list">
        {links.map((l) => (
            <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.label}>
                    {l.icon === 'gh' && (
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
                        </svg>
                    )}
                    {l.icon === 'in' && (
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
                            <rect x="2" y="9" width="4" height="12"/>
                            <circle cx="4" cy="4" r="2"/>
                        </svg>
                    )}
                    {l.icon === 'or' && (
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <text x="12" y="16" font-size="10" font-family="sans-serif" text-anchor="middle" fill="currentColor" stroke="none">iD</text>
                        </svg>
                    )}
                    {l.icon === 'gs' && (
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path d="M12 2 1 8l11 6 9-4.91V17h2V8L12 2z"/>
                            <path d="M5 13.5V18a7 7 0 0 0 14 0v-4.5"/>
                        </svg>
                    )}
                </a>
            </li>
        ))}
    </ul>
</aside>
