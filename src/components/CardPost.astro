---
interface Props {
    url: string;
    image: string;
    title: string;
    date: string;
    external?: boolean;
}

const { url, image, title, date, external = false } = Astro.props;
---

<li class="card">
    <a
        class="card__link"
        href={url}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
    >
        <div class="center">
            <img
                class="card__img"
                width="226"
                height="127"
                src={image}
                alt={title}
                loading="lazy"
            />
        </div>
        <h3 class="card__title">
            {title}
        </h3>
        {date && <p class="card__txt">{date}</p>}
    </a>
</li>
